# Z.ai API Configuration
# Get your API key from https://z.ai/
ZAI_API_KEY=your_api_key_here
ZAI_API_BASE=https://api.z.ai/v1

# Default model
ZAI_MODEL=glm-4.7

# Cost-aware routing configuration (Item 004)
# LAMBDA: Cost-performance trade-off parameter (0.0 = prefer accuracy, 1.0 = prefer cost)
# - 0.0: Always use the most capable model (premium) for best accuracy
# - 0.5: Balanced approach (default)
# - 1.0: Always use the cheapest model (flash) for best cost
LAMBDA=0.5

# COST_RATES: Cost rates per model in USD per 1K tokens
# Format: JSON object mapping model names to cost rates
# Example: {"model_name": {"input": 0.001, "output": 0.002}}
# Update with actual Z.ai pricing from https://z.ai/pricing
COST_RATES='{"glm-4-flash": {"input": 0.0001, "output": 0.0002}, "glm-4.7": {"input": 0.001, "output": 0.002}, "glm-4-plus": {"input": 0.01, "output": 0.02}}'
